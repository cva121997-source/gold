# Browser-safe Supabase config
NEXT_PUBLIC_SUPABASE_URL=https://oidfkbshfywexmvsrkkd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Keep all service-role and provider secrets server-side. Never prefix secrets with NEXT_PUBLIC_.

# SERVER ONLY: required for platform-admin API routes. Never expose this as NEXT_PUBLIC_* or commit its value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Razorpay checkout credentials; never use NEXT_PUBLIC_ for the secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional server-only provider-agnostic rate JSON feed. The URL hostname must match HOST exactly.
# The endpoint must return {"fetched_at":"ISO timestamp","rates":[{"state":"Tamil Nadu","district":"Krishnagiri","city":"Hosur","locality":"optional","metal_code":"gold","purity_code":"22K","price_per_gram":0,"effective_at":"ISO timestamp","expires_at":"ISO timestamp optional","source_label":"optional"}]}.
# Use only an authorised/licensed provider and test its schema before enabling automatic imports.
GOLD_RATE_PROVIDER_NAME=
GOLD_RATE_PROVIDER_URL=
GOLD_RATE_PROVIDER_HOST=
GOLD_RATE_PROVIDER_API_KEY=
GOLD_RATE_REFRESH_SECRET=
# For Vercel Cron, set CRON_SECRET (Vercel supplies Authorization: Bearer <CRON_SECRET> automatically).
CRON_SECRET=

# Optional notification providers. The queue exists; sending adapters, templates and delivery worker
# must be configured/tested before messages are sent.
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
