# Browser-safe Supabase config
NEXT_PUBLIC_SUPABASE_URL=https://oidfkbshfywexmvsrkkd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Keep all service-role and provider secrets server-side. Never prefix secrets with NEXT_PUBLIC_.

# SERVER ONLY: required for platform-admin API routes. Never expose this as NEXT_PUBLIC_* or commit its value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Razorpay checkout credentials; never use NEXT_PUBLIC_ for the secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional server-only provider-agnostic rate JSON feed. GOLD_RATE_PROVIDER_HOST must exactly match URL.hostname.
# Feed JSON contract: { fetched_at?: timezone-aware timestamp, rates: [{ state, metal_code, purity_code,
# price_per_gram: positive number, effective_at: timezone-aware timestamp, district?, city?, locality?,
# expires_at?, source_label? }] }. Codes must match public.metals.code and public.purity_definitions.code.
# Use only an authorised/licensed provider; imported prices stay indicative/private until a shop verifies them.
GOLD_RATE_PROVIDER_NAME=
GOLD_RATE_PROVIDER_URL=
GOLD_RATE_PROVIDER_HOST=
GOLD_RATE_PROVIDER_API_KEY=
GOLD_RATE_REFRESH_SECRET=
# For Vercel Cron, set CRON_SECRET; Vercel sends Authorization: Bearer <CRON_SECRET> automatically.
CRON_SECRET=
# Optional notification providers. The queue exists; sending adapters, templates and delivery worker
# must be configured/tested before messages are sent.
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
